<Window x:Class="DeepSeekTranslator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DeepSeekTranslator"
        Title="DeepSeek 翻译器"
        Width="1000" Height="650"
        WindowStartupLocation="CenterScreen"
        Loaded="OnWindowLoaded"
        Closing="OnWindowClosing"
        Style="{StaticResource DefaultWindowStyle}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Toolbar -->
        <Border Grid.Row="0" 
                Background="{StaticResource SurfaceBrush}" 
                CornerRadius="8" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="源语言：" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="SourceLangCombo" 
                              Width="140" Height="32"
                              DisplayMemberPath="DisplayName"
                              SelectedValuePath="Code"
                              SelectionChanged="OnLanguageChanged"
                              Style="{StaticResource ModernComboBox}"/>
                </StackPanel>

                <Button Grid.Column="1" x:Name="SwapButton"
                        Content="⇄" Width="36" Height="36" FontSize="18"
                        Margin="10,0" ToolTip="交换源语言和目标语言"
                        Click="OnSwapLanguages"
                        Style="{StaticResource IconButton}"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="目标语言：" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="TargetLangCombo" 
                              Width="140" Height="32"
                              DisplayMemberPath="DisplayName"
                              SelectedValuePath="Code"
                              Style="{StaticResource ModernComboBox}"/>
                </StackPanel>

                <TextBlock Grid.Column="3"/>

                <StackPanel Grid.Column="4" Orientation="Horizontal">
                    <Button x:Name="SettingsButton" Content="⚙ 设置"
                            Width="80" Height="32" Margin="0,0,6,0"
                            Click="OnOpenSettings"
                            Style="{StaticResource DefaultButton}"/>
                    <Button x:Name="ThemeButton" Content="🌙"
                            Width="36" Height="32"
                            Click="OnToggleTheme" ToolTip="切换深色/浅色主题"
                            Style="{StaticResource IconButton}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Left / Right Layout -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Source Text -->
            <Border Grid.Column="0" 
                    Background="{StaticResource SurfaceBrush}" 
                    CornerRadius="8" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="源文本" 
                               FontWeight="SemiBold" FontSize="14"
                               Margin="0,0,0,6"/>

                    <TextBox x:Name="SourceTextBox"
                             Grid.Row="1"
                             TextWrapping="Wrap" AcceptsReturn="True"
                             FontSize="14" Padding="8"
                             VerticalScrollBarVisibility="Auto"
                             TextChanged="OnSourceTextChanged"
                             Style="{StaticResource ModernTextBox}"/>

                    <TextBlock Grid.Row="2" x:Name="CharCountText"
                               Text="0 字符" FontSize="11"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               HorizontalAlignment="Right" Margin="0,4,0,0"/>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" Margin="6,4"
                          HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="{StaticResource BorderBrush}"
                          ResizeBehavior="PreviousAndNext"/>

            <!-- Right: Translation Output -->
            <Border Grid.Column="2" 
                    Background="{StaticResource SurfaceBrush}" 
                    CornerRadius="8" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="译文" 
                               FontWeight="SemiBold" FontSize="14"
                               Margin="0,0,0,6"/>

                    <Border Grid.Row="1"
                            Background="{StaticResource InputBackgroundBrush}"
                            CornerRadius="6" Padding="4">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBox x:Name="ResultTextBox"
                                     Text="等待翻译..." FontSize="14"
                                     TextWrapping="Wrap"
                                     IsReadOnly="True"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Foreground="{StaticResource SecondaryTextBrush}"
                                     Style="{x:Null}"/>
                        </ScrollViewer>
                    </Border>

                    <StackPanel Grid.Row="2" Orientation="Horizontal"
                                HorizontalAlignment="Right" Margin="0,6,0,0">
                        <Button x:Name="CopyButton" Content="📋 复制译文"
                                Height="30" Padding="10,0" Margin="0,0,6,0"
                                Click="OnCopyResult"
                                Style="{StaticResource DefaultButton}"/>
                        <Button x:Name="ClearButton" Content="🗑 清空"
                                Height="30" Padding="10,0"
                                Click="OnClear"
                                Style="{StaticResource DefaultButton}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Bottom Bar -->
        <Border Grid.Row="2" 
                Background="{StaticResource SurfaceBrush}" 
                CornerRadius="8" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" x:Name="StatusText"
                           Text="就绪" VerticalAlignment="Center" FontSize="12"
                           Foreground="{StaticResource SecondaryTextBrush}"/>

                <TextBlock Grid.Column="1"/>

                <Button Grid.Column="2" x:Name="TranslateButton"
                        Content="🔄 翻译" Width="100" Height="34"
                        FontSize="14" FontWeight="Bold"
                        IsEnabled="False" Click="OnTranslate"
                        Style="{StaticResource PrimaryButton}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
