<Window x:Class="DeepSeekTranslator.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeepSeek API Key 配置"
        Width="500" Height="350"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Style="{StaticResource DefaultWindowStyle}">
    <Grid Margin="30,25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="DeepSeek API Key 配置" 
                   FontSize="20" FontWeight="Bold" 
                   HorizontalAlignment="Center"
                   Margin="0,0,0,12"/>

        <TextBlock Grid.Row="1" Text="请输入您的 DeepSeek API Key 以启用翻译。" 
                   TextWrapping="Wrap"
                   Margin="0,0,0,4"/>

        <TextBlock Grid.Row="2" Text="访问 https://platform.deepseek.com 获取 API Key。"
                   TextWrapping="Wrap"
                   Foreground="#666"
                   Margin="0,0,0,16"/>

        <StackPanel Grid.Row="3" Orientation="Vertical">
            <TextBlock Text="DeepSeek API Key：" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <PasswordBox x:Name="ApiKeyBox" 
                         Height="36"
                         FontSize="14"
                         Style="{StaticResource ModernPasswordBox}"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="保存" 
                    Width="100" Height="36"
                    Click="OnSave"
                    Style="{StaticResource PrimaryButton}"
                    Margin="0,0,8,0"/>
            <Button Content="取消" 
                    Width="80" Height="36"
                    Click="OnCancel"
                    Style="{StaticResource DefaultButton}"/>
        </StackPanel>
    </Grid>
</Window>
